+/* A block nothing branches to, closing a loop body or an if branch whose code all ended in jumps (the block NIR
+ * keeps after an if whose two sides break or continue). It holds only constants for the phis of its successor
+ * (dxil_nir_move_consts puts them there) and its jump, implicit or explicit, so it is not emitted: DXC never
+ * produces blocks without predecessors, and phis drop their edge from it.
+ */
+static bool
+is_skipped_block(nir_block *block)
+{
+   if (block->predecessors.entries != 0)
+      return false;
+   nir_foreach_instr(instr, block) {
+      if (instr->type != nir_instr_type_load_const &&
+          !(instr->type == nir_instr_type_jump && instr == nir_block_last_instr(block)))
+         return false;
+   }
+   if (block == nir_start_block(nir_cf_node_get_function(&block->cf_node)))
+      return false;
+   return exec_node_is_tail_sentinel(block->cf_node.node.next);
+}
