+/* A DXIL library declares each resource with a global symbol, and the DXIL validator rejects a global
+ * nothing loads ("Internal declaration '...' is unused"). Resource variables are referenced by derefs
+ * (textures, samplers, images) or by vulkan_resource_index (buffers, acceleration structures).
+ */
+static void
+gather_used_resource_vars(struct ntd_context *ctx)
+{
+   ctx->used_resource_vars = _mesa_pointer_set_create(ctx->ralloc_ctx);
+   const nir_variable_mode resource_modes = nir_var_uniform | nir_var_image | nir_var_mem_ubo | nir_var_mem_ssbo;
+   nir_foreach_function_impl(impl, ctx->shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_deref) {
+               nir_deref_instr *deref = nir_instr_as_deref(instr);
+               if (deref->deref_type == nir_deref_type_var && nir_deref_mode_is_one_of(deref, resource_modes))
+                  _mesa_set_add(ctx->used_resource_vars, deref->var);
+            } else if (instr->type == nir_instr_type_intrinsic) {
+               nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+               if (intr->intrinsic != nir_intrinsic_vulkan_resource_index)
+                  continue;
+               nir_foreach_variable_with_modes(var, ctx->shader, resource_modes) {
+                  if (var->data.descriptor_set == nir_intrinsic_desc_set(intr) &&
+                      var->data.binding == nir_intrinsic_binding(intr))
+                     _mesa_set_add(ctx->used_resource_vars, var);
+               }
+            }
+         }
+      }
+   }
+}
+
+/* True when a library leaves out an unreferenced resource variable. It is still reported, so the caller's
+ * root signature is the same as for the other stages.
+ */
+static bool
+skip_unused_resource_var(struct ntd_context *ctx, nir_variable *var, enum dxil_resource_type type)
+{
+   if (!ctx->used_resource_vars || _mesa_set_search(ctx->used_resource_vars, var))
+      return false;
+   ctx->opts->godot_nir_callbacks->report_resource(var->data.binding, var->data.descriptor_set, (uint32_t)type,
+                                                   ctx->opts->godot_nir_callbacks->data);
+   return true;
+}
