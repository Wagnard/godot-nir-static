+}
+
+static bool
+emit_hit_object_execute_shader(struct ntd_context *ctx, nir_intrinsic_instr *intr)
+{
+   nir_deref_instr *payload_deref = nir_src_as_deref(intr->src[1]);
+
+   const struct dxil_func *func = dxil_get_function_with_struct_type(&ctx->mod, "dx.op.hitObject_Invoke",
+                                                                     get_type_for_glsl_type(&ctx->mod, payload_deref->type));
+   if (!func)
+      return false;
+
+   const struct dxil_value *args[] = {
+      dxil_module_get_int32_const(&ctx->mod, DXIL_INTR_HIT_OBJECT_INVOKE),
+      get_hit_object(ctx, intr),
+      ctx->scratchvars[payload_deref->var->data.driver_location]
+   };
+
+   if (!args[0] || !args[1] || !args[2])
+      return false;
+
+   return dxil_emit_call_void(&ctx->mod, func, args, ARRAY_SIZE(args));
+}
+
+static bool
+emit_maybe_reorder_thread(struct ntd_context *ctx, const struct dxil_value *hit_object,
+                          nir_src *hint, nir_src *hint_bits)
+{
+   const struct dxil_func *func = dxil_get_function(&ctx->mod, "dx.op.maybeReorderThread", DXIL_NONE);
+   if (!func)
+      return false;
+
+   const struct dxil_value *args[] = {
+      dxil_module_get_int32_const(&ctx->mod, DXIL_INTR_MAYBE_REORDER_THREAD),
+      hit_object,
+      get_src(ctx, hint, 0, nir_type_uint),
+      get_src(ctx, hint_bits, 0, nir_type_uint),
+   };
+
+   if (!args[0] || !args[1] || !args[2] || !args[3])
+      return false;
+
+   ctx->mod.uses_hit_objects = true;
+   return dxil_emit_call_void(&ctx->mod, func, args, ARRAY_SIZE(args));
+}
+
+static bool
+emit_hit_object_load(struct ntd_context *ctx, nir_intrinsic_instr *intr,
+                     int32_t dxil_intr, enum overload_type overload, bool vector)
+{
+   const struct dxil_func *func = dxil_get_function(&ctx->mod,
+                                                    vector ? "dx.op.hitObject_StateVector" : "dx.op.hitObject_StateScalar",
+                                                    overload);
+   const struct dxil_value *opcode = dxil_module_get_int32_const(&ctx->mod, dxil_intr);
+   const struct dxil_value *hit_object = get_hit_object(ctx, intr);
+   if (!func || !opcode || !hit_object)
+      return false;
+
+   for (unsigned i = 0; i < intr->def.num_components; i++) {
+      const struct dxil_value *args[] = {
+         opcode,
+         hit_object,
+         dxil_module_get_int32_const(&ctx->mod, i),
+      };
+      if (!args[2])
+         return false;
+
+      const struct dxil_value *value = dxil_emit_call(&ctx->mod, func, args, vector ? 3 : 2);
+      if (!value)
+         return false;
+
+      store_def(ctx, &intr->def, i, value);
+   }
+   return true;
+}
