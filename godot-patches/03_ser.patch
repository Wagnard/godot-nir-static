+         return nir_cf_node_as_loop(node);
+   }
+   return NULL;
+}
+
+static bool
+cf_node_contains_block(nir_cf_node *node, nir_block *block)
+{
+   for (nir_cf_node *n = &block->cf_node; n; n = n->parent) {
+      if (n == node)
+         return true;
+   }
+   return false;
+}
+
+static bool
+loop_writes_hit_object(nir_loop *loop, nir_variable *var)
+{
+   nir_foreach_block_in_cf_node(block, &loop->cf_node) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_hit_object_trace_ray &&
+             intr->intrinsic != nir_intrinsic_hit_object_record_empty)
+            continue;
+         if (nir_deref_instr_get_variable(nir_src_as_deref(intr->src[0])) == var)
+            return true;
+      }
+   }
+   return false;
+}
+
+static const struct dxil_value *
+get_hit_object(struct ntd_context *ctx, nir_intrinsic_instr *intr)
+{
+   nir_variable *var = get_hit_object_var(ctx, &intr->src[0]);
+   if (!var)
+      return NULL;
+
+   struct hash_entry *entry = _mesa_hash_table_search(ctx->hit_objects, var);
+   if (!entry) {
+      ctx->logger->log(ctx->logger->priv, "Hit object read before it is written\n");
+      return NULL;
+   }
+
+   const struct hit_object_def *def = entry->data;
+   nir_block *use_block = intr->instr.block;
+   nir_function_impl *impl = nir_cf_node_get_function(&use_block->cf_node);
+   nir_metadata_require(impl, nir_metadata_dominance);
+   if (!nir_block_dominates(def->block, use_block)) {
+      ctx->logger->log(ctx->logger->priv, "Hit object read where its last write does not dominate\n");
+      return NULL;
+   }
+
+   for (nir_loop *loop = get_enclosing_loop(&use_block->cf_node);
+        loop && !cf_node_contains_block(&loop->cf_node, def->block);
+        loop = get_enclosing_loop(&loop->cf_node)) {
+      if (loop_writes_hit_object(loop, var)) {
+         ctx->logger->log(ctx->logger->priv, "Hit object read where a write later in its loop can reach\n");
+         return NULL;
+      }
+   }
+   return def->value;
+}
+
+static bool
+set_hit_object(struct ntd_context *ctx, nir_intrinsic_instr *intr, const struct dxil_value *value)
+{
+   nir_variable *var = get_hit_object_var(ctx, &intr->src[0]);
+   if (!var || !value)
+      return false;
+
+   struct hit_object_def *def = ralloc(ctx->ralloc_ctx, struct hit_object_def);
+   def->value = value;
+   def->block = intr->instr.block;
+   _mesa_hash_table_insert(ctx->hit_objects, var, def);
+   ctx->mod.uses_hit_objects = true;
+   return true;
+}
+
+static const struct dxil_value *
+emit_hit_object_make_nop(struct ntd_context *ctx)
+{
+   const struct dxil_func *func = dxil_get_function(&ctx->mod, "dx.op.hitObject_MakeNop", DXIL_NONE);
+   if (!func)
+      return NULL;
+
+   const struct dxil_value *args[] = {
+      dxil_module_get_int32_const(&ctx->mod, DXIL_INTR_HIT_OBJECT_MAKE_NOP),
+   };
+   if (!args[0])
+      return NULL;
+
+   return dxil_emit_call(&ctx->mod, func, args, ARRAY_SIZE(args));
+}
+
+static bool
