+static nir_def *
+hit_object_load(struct vtn_builder *b, nir_intrinsic_op op, uint32_t hit_object,
+                unsigned num_components, unsigned bit_size)
+{
+   nir_intrinsic_instr *intrin = nir_intrinsic_instr_create(b->nb.shader, op);
+   intrin->src[0] = nir_src_for_ssa(&vtn_nir_deref(b, hit_object)->def);
+   nir_def_init(&intrin->instr, &intrin->def, num_components, bit_size);
+   nir_builder_instr_insert(&b->nb, &intrin->instr);
+   return &intrin->def;
+}
+
+static void
+vtn_handle_hit_object_intrinsic(struct vtn_builder *b, SpvOp opcode,
+                                const uint32_t *w, unsigned count)
+{
+   nir_intrinsic_instr *intrin;
+
+   switch (opcode) {
+   case SpvOpHitObjectTraceRayEXT: {
+      intrin = nir_intrinsic_instr_create(b->nb.shader,
+                                          nir_intrinsic_hit_object_trace_ray);
+      intrin->src[0] = nir_src_for_ssa(&vtn_nir_deref(b, w[1])->def);
