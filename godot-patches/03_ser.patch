+   if (!deref || deref->deref_type != nir_deref_type_var || !deref->var->data.hit_object) {
+      ctx->logger->log(ctx->logger->priv, "Hit objects can only be accessed as whole variables\n");
+      return NULL;
+   }
+   return deref->var;
